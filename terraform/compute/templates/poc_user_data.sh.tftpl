#!/bin/bash
# =============================================================================
# EC2 POC (Fase 2): app Node.js + MySQL local en la misma instancia.
# Basado en el UserdataScript-phase-2 de AWS Academy, con estos cambios:
#   - La app corre como servicio systemd (usuario sin privilegios) en vez de rc.local.
#   - MySQL escucha solo en 127.0.0.1: la migración se hace desde la propia POC.
#   - nodeapp solo tiene privilegios sobre STUDENTS (antes *.*).
# Log: /var/log/cloud-init-output.log
# =============================================================================
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
export HOME=/root

APP_DIR="${app_dir}"
APP_PORT="${app_port}"

# --- Paquetes (reintenta mientras la red termina de levantarse) -------------
for i in $(seq 1 10); do
  apt-get update -y && break
  sleep 15
done
apt-get install -y nodejs npm unzip wget mysql-server

# --- Código de la aplicación -------------------------------------------------
mkdir -p /opt/xyz-app
wget --tries=10 --retry-connrefused --waitretry=10 -q -O /opt/xyz-app/code.zip "${app_code_url}"
unzip -q -o /opt/xyz-app/code.zip -d /opt/xyz-app -x "resources/codebase_partner/node_modules/*"
cd "$APP_DIR"
npm install --no-audit --no-fund aws-sdk@2

# --- MySQL local ---------------------------------------------------------------
# La app, cuando no encuentra el secreto, usa valores fijos en config.js:
# localhost / nodeapp / student12 / STUDENTS. Por eso la contraseña no se puede cambiar.
systemctl enable --now mysql
mysql -u root <<'SQL'
CREATE DATABASE IF NOT EXISTS STUDENTS;
CREATE USER IF NOT EXISTS 'nodeapp'@'%' IDENTIFIED WITH mysql_native_password BY 'student12';
GRANT ALL PRIVILEGES ON STUDENTS.* TO 'nodeapp'@'%';
FLUSH PRIVILEGES;
USE STUDENTS;
CREATE TABLE IF NOT EXISTS students(
  id INT NOT NULL AUTO_INCREMENT,
  name VARCHAR(255) NOT NULL,
  address VARCHAR(255) NOT NULL,
  city VARCHAR(255) NOT NULL,
  state VARCHAR(255) NOT NULL,
  email VARCHAR(255) NOT NULL,
  phone VARCHAR(100) NOT NULL,
  PRIMARY KEY ( id ));
SQL

# --- Servicio systemd ----------------------------------------------------------
id nodeapp >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin nodeapp

cat > /etc/systemd/system/xyz-app.service <<UNIT
[Unit]
Description=XYZ University student records app (POC)
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
User=nodeapp
WorkingDirectory=$APP_DIR
Environment=APP_PORT=$APP_PORT
Environment=APP_DB_HOST=localhost
Environment=APP_DB_USER=nodeapp
Environment=APP_DB_PASSWORD=student12
Environment=APP_DB_NAME=STUDENTS
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now xyz-app.service
